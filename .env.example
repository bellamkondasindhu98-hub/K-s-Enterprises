# ==============================================================================
# K's ENTERPRISES - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Google OAuth 2.0 Client Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Port
PORT=3000
